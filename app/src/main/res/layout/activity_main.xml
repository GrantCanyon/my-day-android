<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F5F7F4">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="22dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="6dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Мой день" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:textColor="#203730" />
        <Button android:id="@+id/today" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Сегодня" android:textAllCaps="false" android:textSize="13sp" android:textColor="#23695D" android:background="@drawable/pill_soft" />
        <Button android:id="@+id/menu" android:layout_width="48dp" android:layout_height="48dp" android:text="⋮" android:textColor="#203730" android:textSize="25sp" android:contentDescription="Экспорт, импорт и настройки" android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:background="@drawable/date_card" android:paddingTop="6dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/previous" android:layout_width="48dp" android:layout_height="56dp" android:text="‹" android:textColor="#E3F0E7" android:textSize="30sp" android:contentDescription="Предыдущий день" android:background="?android:attr/selectableItemBackgroundBorderless" />
            <LinearLayout android:id="@+id/date_picker" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:contentDescription="Выбрать дату" android:background="@drawable/hero_date_ripple">
                <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFF" android:textSize="23sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/date_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#BFD5C8" android:textSize="12sp" android:paddingTop="2dp" android:paddingBottom="4dp" />
            </LinearLayout>
            <Button android:id="@+id/next" android:layout_width="48dp" android:layout_height="56dp" android:text="›" android:textColor="#E3F0E7" android:textSize="30sp" android:contentDescription="Следующий день" android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
            <TextView android:id="@+id/day_summary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="План на день" android:textSize="12sp" android:textColor="#C1D7CA" />
            <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#E1F3D2" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <ProgressBar android:id="@+id/day_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:max="100" android:progressDrawable="@drawable/day_progress" />
    </LinearLayout>
    <RadioGroup android:id="@+id/mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginTop="15dp" android:orientation="horizontal" android:padding="4dp" android:background="@drawable/segment_track">
        <RadioButton android:id="@+id/timeline" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:button="@null" android:gravity="center" android:padding="0dp" android:text="По времени" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:checked="true" android:background="@drawable/segment_tab" android:textColor="@color/segment_text" />
        <RadioButton android:id="@+id/list" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:button="@null" android:gravity="center" android:padding="0dp" android:text="Список дел" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:background="@drawable/segment_tab" android:textColor="@color/segment_text" />
    </RadioGroup>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginStart="22dp" android:layout_marginEnd="18dp" android:gravity="center_vertical">
        <TextView android:id="@+id/section_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Временная шкала" android:textSize="12sp" android:textColor="#728078" />
        <CheckBox android:id="@+id/incomplete" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Осталось" android:textSize="12sp" android:textColor="#52675C" android:contentDescription="Показать только незавершённые дела" android:buttonTint="#23695D" />
    </LinearLayout>
    <ScrollView android:id="@+id/task_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="true" android:overScrollMode="ifContentScrolls" android:scrollbars="none">
        <LinearLayout android:id="@+id/tasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="4dp" android:paddingBottom="14dp" />
    </ScrollView>
    <Button android:id="@+id/add" android:layout_width="match_parent" android:layout_height="52dp" android:minHeight="0dp" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginTop="8dp" android:layout_marginBottom="10dp" android:text="＋  Добавить дело" android:textAllCaps="false" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:background="@drawable/add_button" android:textColor="#FFFFFF" android:stateListAnimator="@null" />
</LinearLayout>
